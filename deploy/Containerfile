# Two stages: build the front end with node, run with python. The runtime image has no node in
# it — the web app is static files by the time the server serves them.

# Pinned to the *build* platform, not the target. The output of this stage is JavaScript, which
# has no architecture, so there is no reason to run tsc and vite under QEMU when cross-building
# the arm64 image for a Raspberry Pi. That emulation is the slowest thing in the whole build.
FROM --platform=$BUILDPLATFORM docker.io/library/node:22-alpine AS web

WORKDIR /build
COPY web/package.json web/package-lock.json* ./
RUN npm install --no-audit --no-fund
COPY web/ ./
RUN npm run build


FROM docker.io/library/python:3.12-slim

# Links the published GHCR package back to this repository, which is also what lets the package
# inherit the repo's visibility instead of being an orphan that has to be made public by hand.
LABEL org.opencontainers.image.source="https://github.com/Saavuori/wifi-csi-app" \
      org.opencontainers.image.description="WiFi CSI ingest, recording, replay and analysis"

# scipy needs a BLAS at runtime. Installing it here rather than letting pip pull a wheel that
# bundles its own keeps the image smaller and the numerics consistent with the base distro.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libopenblas0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY server/pyproject.toml ./server/
COPY server/csi ./server/csi
RUN pip install --no-cache-dir ./server

COPY --from=web /build/dist ./web/dist

# Build identity, passed in by CI and surfaced on /api/version and in the UI. Declared after
# the pip install so that changing a commit SHA does not invalidate the dependency layer —
# these move on every build and the wheels do not.
ARG CSI_VERSION=dev
ARG CSI_COMMIT=""
ARG CSI_BUILT_AT=""
ENV CSI_VERSION=${CSI_VERSION} \
    CSI_COMMIT=${CSI_COMMIT} \
    CSI_BUILT_AT=${CSI_BUILT_AT}

# Standard annotations, so `docker inspect` and the GHCR listing agree with /api/version.
LABEL org.opencontainers.image.version="${CSI_VERSION}" \
      org.opencontainers.image.revision="${CSI_COMMIT}" \
      org.opencontainers.image.created="${CSI_BUILT_AT}"

ENV CSI_WEB_DIR=/app/web/dist \
    CSI_DATA_DIR=/data \
    CSI_UDP_HOST=0.0.0.0 \
    CSI_UDP_PORT=5566 \
    CSI_HTTP_PORT=8080 \
    PYTHONUNBUFFERED=1

# One BLAS thread. Every matrix in the analysis path is small — a few hundred samples by a few
# dozen subcarriers — and at that size OpenBLAS's threading costs more in synchronization than
# it saves. On a four-core Pi it is worse than neutral: the extra threads contend with the
# single event loop that is also doing UDP ingest and WebSocket fan-out.
ENV OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1

# Recordings live on a volume. At 80 Hz a node writes roughly a gigabyte a day, and losing a
# session is far more expensive than the disk it takes.
VOLUME ["/data"]

EXPOSE 8080/tcp 5566/udp

# The nodes send UDP from the LAN, so this container needs to be reachable on 5566 from outside
# the host's loopback — see deploy/README.md for the podman run line.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s \
    CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8080/api/healthz').read()"

CMD ["python", "-m", "csi"]
